{
	"$schema": "https://devin.ai/schema/config.json",
	"version": "1.0.0",
	"project": {
		"name": "Academia PayGas",
		"description": "Corporate LMS for PayGas gas station employees",
		"type": "fullstack",
		"stack": {
			"frontend": {
				"framework": "React 19",
				"build": "Vite",
				"ui": "shadcn/ui + Radix UI + TailwindCSS 4",
				"language": "TypeScript",
				"entry": "src/main.tsx"
			},
			"backend": {
				"framework": "Express 5",
				"language": "TypeScript",
				"database": "PostgreSQL (primary) + MySQL (backup)",
				"orm": "Prisma",
				"entry": "server/index.ts",
				"port": 3001
			}
		}
	},
	"agent": {
		"profile": "SWE-1.6 Slow",
		"mode": "normal",
		"instructions": ".devin/instructions.md",
		"workflow": ".devin/workflow.md"
	},
	"tools": {
		"codebase-memory-mcp": {
			"enabled": true,
			"project": "home-soporte24hwww-Documentos-Repositorios-academia-paygas",
			"priority": "always",
			"fallback": "rg, fd, ast-grep, LSP"
		},
		"task-master": {
			"enabled": true,
			"path": ".taskmaster",
			"auto-create": true,
			"auto-expand": true
		}
	},
	"preferences": {
		"search": {
			"primary": "codebase-memory-mcp",
			"text": "rg",
			"files": "fd",
			"refactor": "ast-grep",
			"symbols": "LSP"
		},
		"code_style": {
			"linter": "biome",
			"formatter": "biome",
			"config": "biome.json",
			"tabs": true,
			"quotes": "double",
			"trailing_commas": true,
			"line_width": 120
		},
		"language": {
			"ui_strings": "pt-BR",
			"identifiers": "pt-BR",
			"comments": "en"
		},
		"database": {
			"access_layer": "server/lib/db.ts",
			"never_call_prisma_directly": true,
			"migrations_required": true
		},
		"verification": {
			"lint": "pnpm lint",
			"typecheck_frontend": "npx tsc --noEmit",
			"typecheck_backend": "npx tsc --project tsconfig.server.json --noEmit",
			"build": "pnpm build",
			"database": "npx prisma migrate deploy"
		}
	},
	"hooks": {
		"before_change": ["verify_dependencies_installed", "check_git_status", "verify_env_file"],
		"after_change": ["run_lint", "run_typecheck", "update_task_master"],
		"before_commit": ["run_build", "verify_database_migrations"],
		"after_commit": ["update_memory", "document_decision"]
	},
	"rules": {
		"pre_flight_checks": ["pnpm installed", "dependencies installed", ".env file exists"],
		"never": [
			"call prisma.* directly in routes",
			"expose secrets in code",
			"disable auth middleware",
			"modify security policies",
			"use grep (use rg instead)",
			"use find (use fd instead)"
		],
		"always": [
			"use codebase-memory-mcp first",
			"reuse existing code",
			"respect existing architecture",
			"document decisions",
			"verify before closing tasks"
		]
	},
	"paths": {
		"frontend": "src",
		"backend": "server",
		"components": "src/components",
		"pages": "src/pages",
		"hooks": "src/hooks",
		"routes": "server/routes",
		"middleware": "server/middleware",
		"services": "server/services",
		"lib": "server/lib",
		"database": "prisma"
	},
	"gotchas": [
		"pnpm build must run prisma generate before vite/tsc",
		"Dev mode has no database failover",
		"CASL action list is hardcoded in authorize() middleware",
		"CASL conditions must be JSON.stringified",
		"Frontend CASL is custom (not @casl/ability library)",
		"db.transaction() only uses primary Prisma client",
		"Two PrismaClient instances for PG_URL_1",
		"db-models.ts always uses allEntries[0] as primary",
		"HTTPS auto-detection from server/certs/key.pem and cert.pem"
	],
	"documentation": {
		"main": "AGENTS.md",
		"devin": ".devin/README.md",
		"instructions": ".devin/instructions.md",
		"workflow": ".devin/workflow.md",
		"memory": ".devin/memory.md",
		"tasks": ".devin/tasks.md",
		"patterns": ".devin/patterns.md",
		"verification": ".devin/verification.md",
		"context": ".devin/project-context.md"
	},
	"verification": {
		"no_test_framework": true,
		"manual_verification": "API health check + seed data",
		"lint_required": true,
		"typecheck_required": true,
		"build_required": true
	}
}
