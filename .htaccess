# Academia PayGas - Security
# Desactivar mod_pagespeed
<IfModule mod_pagespeed.c>
    Pagespeed Off
</IfModule>

# Block access to sensitive files
<FilesMatch "^(\.env|\.git|\.htaccess|\.htpasswd)$">
    Require all denied
</FilesMatch>

# Block access to .env variants
<FilesMatch "\.env">
    Require all denied
</FilesMatch>
