# ═══════════════════════════════════════════════════════════
# Academia PayGas - cPanel Security
# ═══════════════════════════════════════════════════════════

# Disable directory listing
Options -Indexes

# Block access to sensitive files
<FilesMatch "^(\.env|\.env\.|\.git|\.htaccess|\.htpasswd|.*\.json|.*\.lock|.*\.md|.*\.zip|.*\.sql|tsconfig\.json|vite\.config\.ts|tailwind\.config\.ts|postcss\.config\.mjs|prisma\.config\.ts|eslint\.config\.js)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block access to server directory
<DirectoryMatch "^/server">
    Order Allow,Deny
    Deny from all
</DirectoryMatch>

# Block access to prisma directory
<DirectoryMatch "^/prisma">
    Order Allow,Deny
    Deny from all
</DirectoryMatch>

# Block access to node_modules
<DirectoryMatch "^/node_modules">
    Order Allow,Deny
    Deny from all
</DirectoryMatch>

# Block access to source code
<DirectoryMatch "^/src">
    Order Allow,Deny
    Deny from all
</DirectoryMatch>

# Allow access to dist directory (compiled frontend)
<DirectoryMatch "^/dist">
    Order Allow,Deny
    Allow from all
</DirectoryMatch>

# Enable gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE application/rss+xml application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Enable browser caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/json "access plus 1 hour"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/eot "access plus 1 year"
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
