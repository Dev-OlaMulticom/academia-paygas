{
  "buildCommand": "npx prisma generate && npx vite build && npx tsc --project tsconfig.server.json --noCheck",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "pnpm install",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
