# ===========================================
# Academia PayGas - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Production target: Neon Postgres (serverless-friendly, pooled connections).
#
# Neon gives you two connection strings per branch:
#   - Pooled  (host ends in "-pooler")  -> use for PG_URL_1 / DATABASE_URL
#     (the app, on Vercel, opens a new pool per cold start — pooling is
#     required to avoid exhausting Postgres' max_connections).
#   - Direct  (no "-pooler")            -> use for DIRECT_URL
#     (Prisma Migrate needs a direct, non-pooled connection).
#
# PG_URL_1 takes precedence over DATABASE_URL as primary. Do NOT set
# PG_URL_2/PG_URL_3 or MYSQL_URL in serverless deployments — the multi-DB
# failover + dual-write code path is meant for the persistent cPanel
# process; on Vercel it just adds latency per request with no benefit
# (there is only one live process to fail over from).
PG_URL_1="postgres://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/academia_paygas?sslmode=require"

# DATABASE_URL is required by Prisma migrations if PG_URL_1 is unset — keep
# it identical to PG_URL_1 for consistency.
DATABASE_URL="postgres://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/academia_paygas?sslmode=require"

# Direct (non-pooled) connection, used by `prisma migrate deploy`/`dev`.
DIRECT_URL="postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/academia_paygas?sslmode=require"

# MySQL backup (third-tier, different engine) — leave unset on Vercel/Cloudflare.
# MYSQL_URL="mysql://root:@localhost:3306/academia_paygas"

# ===========================================
# KEEP-ALIVE & HEALTH CHECKS
# ===========================================
# Enable DB infrastructure services (keepalive, health-checks, sync worker)
# in development. Disabled by default in dev to avoid noise during local
# iteration. Always ON in production.
# DB_INFRA_DEV="1"

# Interval between keep-alive pings (default: 12 hours = 43200000ms)
KEEPALIVE_INTERVAL_MS=43200000

# Delay before first keep-alive ping (default: 5 minutes = 300000ms)
KEEPALIVE_FIRST_DELAY_MS=300000

# ===========================================
# AUTHENTICATION
# ===========================================
# JWT secret for authentication tokens
# IMPORTANT: Use a strong, random string (at least 32 characters)
# If not provided or weak, a dynamic secret will be generated at runtime and
# persisted to a `.jwt-secret` file — that fallback does NOT work reliably on
# Vercel/Cloudflare (ephemeral/read-only filesystem, no shared state between
# invocations). Always set JWT_SECRET explicitly for serverless deployments.
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# ===========================================
# ENCRYPTION
# ===========================================
# Encryption key for AES-256-GCM payload encryption
# If not provided, a dynamic key will be generated at runtime — same caveat
# as JWT_SECRET above: set this explicitly on Vercel/Cloudflare so all
# function instances (and cold starts) agree on the same key.
ENCRYPTION_KEY="your-encryption-key"

# ===========================================
# APPLICATION URL
# ===========================================
# Main application URL (used for email links, CORS, etc.)
APP_URL="https://academia.paygas.com.br"

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Comma-separated list of allowed origins.
# Note: when the Cloudflare Worker proxies /api/* to Vercel (see
# worker/index.ts + API_ORIGIN below), browser requests to the API are
# same-origin from the Cloudflare domain's point of view, so CORS isn't
# exercised for that path. Still list every domain that may call the API
# directly (custom domain, Cloudflare *.workers.dev, Vercel preview URLs).
ALLOWED_ORIGINS="https://academia.paygas.com.br,http://localhost:5173,http://localhost:3001"

# ===========================================
# DEPLOYMENT: CLOUDFLARE WORKER (frontend + API proxy)
# ===========================================
# Set as a `var` (or secret) in wrangler.toml / `wrangler secret put API_ORIGIN`.
# Points the Worker's /api/* proxy at the Vercel deployment running the
# Express API. No trailing slash.
# API_ORIGIN="https://academia-paygas.vercel.app"

# ===========================================
# SMTP EMAIL CONFIGURATION
# ===========================================
# SMTP server settings for sending emails
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="465"
SMTP_USER="email@your-domain.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="email@your-domain.com"
SMTP_SECURE="true"

# ===========================================
# ADMIN CONFIGURATION
# ===========================================
# Super admin email (for notifications)
EMAIL_SUPERADMIN="admin@your-domain.com"

# ===========================================
# FRONTEND CONFIGURATION (Vite)
# ===========================================
# These are used during build time for the frontend
# API base URL for frontend (default: /api for same-origin)
VITE_API_BASE_URL="/api"

# ===========================================
# NODE ENVIRONMENT
# ===========================================
# Set to 'production' in production environment
NODE_ENV="development"
PORT="3001"

# ===========================================
# EXTERNAL PAYGAS API (Acesso PayGas flow)
# ===========================================
# Used by /api/auth/paygas-access to verify employees via CPF or Email.
# TODO: replace placeholder values with real ones from the PayGas team.
PAYGAS_API_URL="https://api-paygas.example.com/v1"
PAYGAS_API_KEY=""
PAYGAS_API_TIMEOUT_MS=10000

# ===========================================
# PAYGAS SSO (Single Sign-On)
# ===========================================
# Used by GET /api/sso to validate SSO tickets against the PayGas API.
# PAYGAS_API_URL is shared with the Acesso PayGas flow above.
PAYGAS_API_CHAVE=""
PAYGAS_API_SECRET=""

# ===========================================
# PERFIL SERVIDOR PEQUEÑO (0.1 vCPU / 256 MB)
# ===========================================
# El docker-compose.yml ya fija valores conservadores; estos flags
# permiten ajustar fino sin tocar código.
#
# Sockets por pool de Postgres (default 10; MICRO_MODE=2)
PG_POOL_SIZE="3"
# Desactiva el full hash-diff horario (caro en CPU); queda solo incremental
FULL_SYNC_OFF="1"
# Intervalos del sync worker (ms)
INCREMENTAL_INTERVAL_MS="60000"
SYNC_START_DELAY_MS="30000"
# Omite el sync de migraciones del boot (deploy.sh las aplica)
MIGRATIONS_SYNC_OFF="1"
# Modo micro: solo health checks + keep-alive, sin sync ni realtime
# MICRO_MODE="1"
