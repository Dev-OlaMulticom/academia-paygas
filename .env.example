# ===========================================
# Academia PayGas - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# ===========================================
# DATABASE CONFIGURATION (Multi-PG)
# ===========================================
# Primary PostgreSQL (Supabase or any provider)
# PG_URL_1 takes precedence over DATABASE_URL as primary
PG_URL_1="postgres://postgres:password@your-project.supabase.co:5432/postgres?sslmode=require"

# Backup PostgreSQL (Nhost or any provider)
# If PG_URL_1 goes down, reads failover to PG_URL_2
PG_URL_2="postgres://postgres:password@your-project.db.sa-east-1.nhost.run:5432/your-project?sslmode=require"

# Legacy fallback (used if PG_URL_1 is not set)
DATABASE_URL="postgres://postgres:password@localhost:5432/academia_paygas?sslmode=require"

# Direct connection URL (without SSL, for migrations)
DIRECT_URL="postgres://postgres:password@localhost:5432/academia_paygas"

# MySQL (backup/redundancy — third-tier, different engine)
MYSQL_URL="mysql://root:@localhost:3306/academia_paygas"

# ===========================================
# KEEP-ALIVE & HEALTH CHECKS
# ===========================================
# Interval between keep-alive pings (default: 12 hours = 43200000ms)
KEEPALIVE_INTERVAL_MS=43200000

# Delay before first keep-alive ping (default: 5 minutes = 300000ms)
KEEPALIVE_FIRST_DELAY_MS=300000

# ===========================================
# AUTHENTICATION
# ===========================================
# JWT secret for authentication tokens
# IMPORTANT: Use a strong, random string (at least 32 characters)
# If not provided or weak, a dynamic secret will be generated at runtime
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# ===========================================
# ENCRYPTION
# ===========================================
# Encryption key for AES-256-GCM payload encryption
# If not provided, a dynamic key will be generated at runtime
# ENCRYPTION_KEY="your-encryption-key"

# ===========================================
# APPLICATION URL
# ===========================================
# Main application URL (used for email links, CORS, etc.)
APP_URL="https://academia.paygas.com.br"

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="https://academia.paygas.com.br,http://localhost:5173,http://localhost:3001"

# ===========================================
# SMTP EMAIL CONFIGURATION
# ===========================================
# SMTP server settings for sending emails
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="465"
SMTP_USER="email@your-domain.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@your-domain.com"
SMTP_SECURE="true"

# ===========================================
# ADMIN CONFIGURATION
# ===========================================
# Super admin email (for notifications)
EMAIL_SUPERADMIN="admin@your-domain.com"

# ===========================================
# FRONTEND CONFIGURATION (Vite)
# ===========================================
# These are used during build time for the frontend
# API base URL for frontend (default: /api for same-origin)
VITE_API_BASE_URL="/api"

# ===========================================
# NODE ENVIRONMENT
# ===========================================
# Set to 'production' in production environment
NODE_ENV="development"
