# ═══════════════════════════════════════════════════════════
# Academia PayGas - Production Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values for production
# ═══════════════════════════════════════════════════════════

# Database URL (PostgreSQL)
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Admin Email
EMAIL_SUPERADMIN="admin@academia.paygas.com.br"

# Encryption key for payload encryption (AES-256-GCM)
# IMPORTANT: Generate a strong random key for production
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-production-encryption-key-here"

# JWT secret for authentication tokens
# IMPORTANT: Generate a strong random key for production
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-production-jwt-secret-here"

# API Configuration (WordPress integration)
API_BASE_URL="https://academia.paygas.com.br/www/index.php?rest_route=/academia-paygas/v1"
API_KEY="your-wordpress-api-key"

# Frontend API Configuration
# In production, this should be "/api" (same-origin)
VITE_API_BASE_URL="/api"
VITE_API_KEY="your-wordpress-api-key"

# SMTP Configuration (Email Service)
SMTP_HOST="academia.paygas.com.br"
SMTP_PORT="465"
SMTP_USER="email@academia.paygas.com.br"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@academia-paygas.com"
SMTP_SECURE="true"

# Application URL
APP_URL="https://academia.paygas.com.br"

# Server Port (cPanel will set this automatically)
PORT=3001
