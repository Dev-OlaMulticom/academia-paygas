{
	"name": "academia-paygas",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"postinstall": "cp -f node_modules/lucide-static/font/lucide.woff2 node_modules/lucide-static/font/lucide.woff node_modules/lucide-static/font/lucide.ttf node_modules/lucide-static/font/lucide.css apps/web/public/ 2>/dev/null || true",
		"dev": "bun run --parallel dev:server dev:client",
		"dev:client": "vite --config apps/web/vite.config.ts",
		"dev:server": "bun --watch apps/api/src/server/fastify.ts",
		"build": "bun run --parallel build:client build:server:tsc",
		"build:server:tsc": "tsc --project tsconfig.server.json",
		"build:server": "esbuild apps/api/src/server/fastify.ts --bundle --platform=node --format=cjs --packages=external --alias:@shared=./packages/shared/src --outfile=dist/server/index.js",
		"build:client": "vite build --config apps/web/vite.config.ts && cp -r apps/web/dist/client/. dist/ && mkdir -p dist/client && cp -r apps/web/dist/client/. dist/client/",
		"preview": "vite preview --config apps/web/vite.config.ts",
		"start": "node dist/server/index.js",
		"start:prod": "NODE_ENV=production node dist/server/index.js",
		"prestart": "node -e \"if(!require('fs').existsSync('dist/server/index.js')){console.error('Build not found. Run: npm run build'); process.exit(1)}\"",
		"healthcheck": "node -e \"const h=require('http');h.get('http://localhost:3001/api/health',r=>{let d='';r.on('data',c=>d+=c);r.on('end',()=>{try{const j=JSON.parse(d);process.exit(j.status==='ok'?0:1)}catch{process.exit(1)}})}).on('error',()=>process.exit(1))\"",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "bun test",
		"db:generate": "npx prisma generate --schema=packages/db/prisma/schema.prisma",
		"db:migrate": "npx prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
		"db:seed": "bun packages/db/prisma/seed.ts",
		"db:reset-admin": "bun packages/db/prisma/reset-admin.ts",
		"db:reset": "prisma migrate reset --force --schema=packages/db/prisma/schema.prisma && pnpm db:seed",
		"db:push": "npx prisma db push --schema=packages/db/prisma/schema.prisma",
		"db:generate:mysql": "npx prisma generate --schema=packages/db/prisma/schema.mysql.prisma",
		"db:sync-mysql": "bun packages/db/prisma/sync-mysql.ts",
		"cf:build": "vite build --config apps/web/vite.config.ts",
		"dev:worker": "npx wrangler dev --cwd apps/worker",
		"deploy:worker": "npx wrangler deploy --cwd apps/worker",
		"typecheck:worker": "npx tsc --noEmit -p apps/worker/tsconfig.json"
	},
	"prisma": {
		"seed": "tsx packages/db/prisma/seed.ts"
	},
