{
	"name": "academia-paygas",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
		"dev:client": "vite --config apps/web/vite.config.ts",
		"dev:server": "tsx watch apps/api/src/server/index.ts",
		"build": "npx prisma generate --schema=packages/db/prisma/schema.prisma && npx prisma generate --schema=packages/db/prisma/schema.mysql.prisma && concurrently -k -n vite,tsc \"vite build --config apps/web/vite.config.ts\" \"npx tsc --project tsconfig.server.json\"",
		"build:server": "npx prisma generate --schema=packages/db/prisma/schema.prisma && npx prisma generate --schema=packages/db/prisma/schema.mysql.prisma && npx tsc --project tsconfig.server.json",
		"build:client": "vite build --config apps/web/vite.config.ts",
		"preview": "vite preview --config apps/web/vite.config.ts",
		"start": "node dist/server/index.js",
		"start:prod": "NODE_ENV=production node dist/server/index.js",
		"prestart": "node -e \"if(!require('fs').existsSync('dist/server/index.js')){console.error('Build not found. Run: npm run build'); process.exit(1)}\"",
		"healthcheck": "node -e \"const h=require('http');h.get('http://localhost:3001/api/health',r=>{let d='';r.on('data',c=>d+=c);r.on('end',()=>{try{const j=JSON.parse(d);process.exit(j.status==='ok'?0:1)}catch{process.exit(1)}})}).on('error',()=>process.exit(1))\"",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "node --import tsx --test apps/api/tests/*.test.ts",
		"db:generate": "npx prisma generate --schema=packages/db/prisma/schema.prisma",
		"db:migrate": "npx prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
		"db:seed": "tsx packages/db/prisma/seed.ts",
		"db:reset-admin": "tsx packages/db/prisma/reset-admin.ts",
		"db:reset": "prisma migrate reset --force --schema=packages/db/prisma/schema.prisma && pnpm db:seed",
		"db:push": "npx prisma db push --schema=packages/db/prisma/schema.prisma",
		"db:generate:mysql": "npx prisma generate --schema=packages/db/prisma/schema.mysql.prisma",
		"db:sync-mysql": "tsx packages/db/prisma/sync-mysql.ts",
		"cpanel:build": "npx prisma generate --schema=packages/db/prisma/schema.prisma && npx prisma generate --schema=packages/db/prisma/schema.mysql.prisma && concurrently -k -n vite,tsc \"vite build --config apps/web/vite.config.ts\" \"npx tsc --project tsconfig.server.json\"",
		"cf:build": "vite build --config apps/web/vite.config.ts",
		"dev:worker": "npx wrangler dev --cwd apps/worker",
		"deploy:worker": "npx wrangler deploy --cwd apps/worker",
		"typecheck:worker": "npx tsc --noEmit -p apps/worker/tsconfig.json"
	},
	"prisma": {
		"seed": "tsx packages/db/prisma/seed.ts"
	},
	"dependencies": {
		"@casl/ability": "^7.0.0",
		"@casl/prisma": "^2.0.1",
		"@casl/react": "^7.0.0",
		"@hookform/resolvers": "^3.9.1",
		"@prisma/adapter-mariadb": "^7.8.0",
		"@prisma/adapter-pg": "^7.8.0",
