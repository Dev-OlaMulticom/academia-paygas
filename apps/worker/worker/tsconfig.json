{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022"],
		"types": ["@cloudflare/workers-types"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"paths": {
			"@shared/*": ["./../shared/*"]
		}
	},
	"include": ["**/*.ts", "../shared/**/*.ts"]
}
